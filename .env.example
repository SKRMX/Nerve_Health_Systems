# ==========================================
# NERVE Health Systems - Environment Example
# ==========================================
# Copia este archivo a .env.local y configura tus valores reales.
# Nunca subas secretos reales al repositorio.

# Supabase (Base de Datos, Autenticación y Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Stripe (Suscripciones de Plataforma y Stripe Connect para Médicos)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Mercado Pago (Suscripciones y Cobros OAuth)
MP_CLIENT_ID="your_mercadopago_client_id"
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-your-mercadopago-public-key"
MP_ACCESS_TOKEN="APP_USR-your-mercadopago-access-token"

# Evolution API (WhatsApp Multi-Tenant Gateway)
EVOLUTION_API_URL="https://your-evolution-api-domain.com"
EVOLUTION_GLOBAL_API_KEY="your_evolution_global_api_key"
NERVE_WA_INSTANCE_TOKEN="your_platform_whatsapp_instance_token"

# Resend (Correos Transaccionales y Notificaciones)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="NERVE Health Systems <soporte@example.com>"

# Telegram (Alertas Internas de Plataforma)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Seguridad para Tareas Programadas (Cron Jobs de Recordatorios y Resúmenes)
CRON_SECRET="your_cron_secret_token"
